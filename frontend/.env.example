# ============================================================
# Hyper Vibe Course — Frontend Environment Variables
# ============================================================
#
# ⚠️  READ THIS FIRST — env files in THIS directory are NOT loaded.
#
# vite.config.ts sets `envDir` to the REPO ROOT, so Vite reads
#   <repo root>/.env.local        ← put your real values HERE
# and never reads frontend/.env or frontend/.env.local. A var set in
# this directory is silently ignored — no warning, no error.
#
# The classic symptom: VITE_BROSKIPET_CONTRACT_ADDRESS set here leaves
# IS_BROSKIPET_CONFIGURED false, and the mint button on /pets renders
# "Mint temporarily unavailable" while looking like a wallet bug.
#
# This file is kept as the reference list of frontend vars. Copy the
# ones you need into the ROOT .env.local, not into frontend/.
#
# NEVER commit .env.local to git. NEVER put secrets in VITE_ vars
# (they are embedded in the browser bundle and visible to users).
# ============================================================

# --- Supabase (required) ---
# Find these in: supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SECURITY: The anon key is safe to expose — it is rate-limited by RLS.
# The SERVICE ROLE KEY is NOT safe — it bypasses RLS.
# Service role key belongs in a server-side function ONLY (never here).

VITE_HYPERCODE_API_URL=http://localhost:8000
# --- Stripe (optional — required for payment links) ---
# Find this in: dashboard.stripe.com → Payment Links → copy the URL
VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/your-payment-link

# Stripe publishable key (only needed if using Stripe.js/Elements directly)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- Mission Control (admin easter-egg link) ---
# The footer's `weird` Link points to /admin/mission-control, which
# launches into the standalone WelshDog-Mission-Control app. Set this
# to the deployed MC URL in prod; defaults to http://localhost:5174
# (the dev port the MC repo uses) when unset.
VITE_MISSION_CONTROL_URL=http://localhost:5174

# Optional: if Mission Control backend is not same-origin, set this.
# Example: http://localhost:8088 or https://mission-control.example.com
VITE_MISSION_CONTROL_API_URL=http://localhost:8088

# --- BROskiPet dNFT (Web3) ---
# Free WalletConnect Cloud project ID — cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
# 84532 = Base Sepolia (testnet, default), 8453 = Base mainnet
VITE_BROSKIPET_CHAIN_ID=84532
# Set after deploying contracts/src/BROskiPet.sol via DeployBROskiPet.s.sol
VITE_BROSKIPET_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================================
# Keys that should NEVER go in this file:
#   - Supabase service role key (sb_secret_... or eyJ...service_role...)
#   - Supabase database password
#   - Stripe secret key (sk_live_... or sk_test_...)
#   - Any API secret / private key
#
# If you accidentally committed secrets → rotate them immediately:
#   Supabase: supabase.com → Project Settings → API → Rotate
#   Stripe:   dashboard.stripe.com → Developers → API keys → Roll
# ============================================================
