# Course Content Agent — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# Supabase (service_role key — agent use ONLY, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic (for Claude quiz generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# GitHub repo slug (for audit logs)
GITHUB_REPO=welshDog/Hyper-Vibe-Coding-Course

# Directory containing module scripts (relative to agent root)
SCRIPTS_DIR=../../scripts
