# =============================================================
# 🔥 HYPER VIBE CODING COURSE — ENVIRONMENT VARIABLES
# Copy this to .env.local (never commit .env.local to git!)
# =============================================================

# --- SUPABASE ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- STRIPE PUBLISHABLE KEY (safe to expose in frontend) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# --- STRIPE PAYMENT LINKS ---
# Get these from: Stripe Dashboard → Payment Links → Create Link
# See STRIPE_SETUP.md for step-by-step instructions

# 🌱 Starter — £29 one-time (Module 1 only)
VITE_STRIPE_STARTER_URL=https://buy.stripe.com/REPLACE_ME

# ⚡ Pro — £49 one-time (Modules 1-4)
VITE_STRIPE_PRO_URL=https://buy.stripe.com/REPLACE_ME

# 🔥 Builder — £97 one-time (Modules 1-9) — HERO tier
VITE_STRIPE_BUILDER_URL=https://buy.stripe.com/REPLACE_ME

# 🔥 Builder — £12/month (Modules 1-9)
VITE_STRIPE_BUILDER_MONTHLY_URL=https://buy.stripe.com/REPLACE_ME

# 🏛️ Architect — £167 one-time (Modules 1-11)
VITE_STRIPE_ARCHITECT_URL=https://buy.stripe.com/REPLACE_ME

# 🏛️ Architect — £18/month (Modules 1-11)
VITE_STRIPE_ARCHITECT_MONTHLY_URL=https://buy.stripe.com/REPLACE_ME

# ⚛️ Hyper Legend — £247 one-time (Modules 1-13 + Quantum)
VITE_STRIPE_HYPER_LEGEND_URL=https://buy.stripe.com/REPLACE_ME

# ⚛️ Hyper Legend — £25/month (Modules 1-13 + Quantum)
VITE_STRIPE_HYPER_LEGEND_MONTHLY_URL=https://buy.stripe.com/REPLACE_ME

# --- STRIPE PRICE IDs (used by stripe/products.config.ts + Supabase webhook) ---
# 🌱 Starter
STRIPE_PRICE_STARTER_ONE_TIME=price_xxx
# ⚡ Pro
STRIPE_PRICE_PRO_ONE_TIME=price_xxx
# 🔥 Builder
STRIPE_PRICE_BUILDER_ONE_TIME=price_xxx
STRIPE_PRICE_BUILDER_MONTHLY=price_xxx
# 🏛️ Architect
STRIPE_PRICE_ARCHITECT_ONE_TIME=price_xxx
STRIPE_PRICE_ARCHITECT_MONTHLY=price_xxx
# ⚛️ Hyper Legend
STRIPE_PRICE_HYPER_LEGEND_ONE_TIME=price_xxx
STRIPE_PRICE_HYPER_LEGEND_MONTHLY=price_xxx

# --- STRIPE WEBHOOK (backend / Supabase Edge Function only) ---
# NEVER put these in frontend .env!
# Set these in: Supabase Dashboard → Edge Functions → Secrets
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# SUPABASE_SERVICE_ROLE_KEY=xxx

# --- DISCORD ---
# NEVER commit the real token — set in Vercel + local .env only
# Get from: Discord Developer Portal → Your App → Bot → Token
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_SERVER_ID=your-discord-server-id
DISCORD_VERIFIED_ROLE_ID=your-verified-role-id
