// Hyper Vibe Course Platform - Database Schema
// Edit this file to change your database structure

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  displayName       String
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Gamification
  totalXp           Int      @default(0)
  currentLevel      Int      @default(1)
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  broskiCoins       Int      @default(0)
  lastActiveDate    DateTime?

  // Accessibility preferences stored per user
  prefDyslexiaFont  Boolean  @default(false)
  prefReducedMotion Boolean  @default(false)
  prefHighContrast  Boolean  @default(false)
  prefLargeText     Boolean  @default(false)
  prefDarkMode      Boolean  @default(true)

  // Relations
  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  userBadges        UserBadge[]
  xpEvents          XpEvent[]
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  level       String   // beginner | intermediate | hyper-pro
  durationWeeks Int
  price       Float    @default(0)
  isFree      Boolean  @default(false)
  isPublished Boolean  @default(false)
  coverImage  String?
  createdAt   DateTime @default(now())

  // Relations
  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String
  orderIndex  Int
  emoji       String   @default("📚")

  // Relations
  course      Course   @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  content     Json     // Flexible JSON content (text, video, code blocks)
  orderIndex  Int
  xpReward    Int      @default(25)
  estimatedMinutes Int @default(15)

  // Relations
  module      Module   @relation(fields: [moduleId], references: [id])
  progress    LessonProgress[]
}

model Enrollment {
  id          String   @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  progressPct Float    @default(0)

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  emoji       String
  xpReward    Int      @default(50)

  // Relations
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id])
}
