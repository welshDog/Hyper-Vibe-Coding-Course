{
  "_comment": "Copy this to config/video-config.json and fill in your values. Never commit real keys.",
  "heygen": {
    "api_key_env": "HEYGEN_API_KEY",
    "avatar_id": "YOUR_HEYGEN_AVATAR_ID",
    "voice_id": "YOUR_HEYGEN_VOICE_ID",
    "test_mode": true
  },
  "synthesia": {
    "api_key_env": "SYNTHESIA_API_KEY",
    "template_id": "YOUR_SYNTHESIA_TEMPLATE_ID"
  },
  "youtube": {
    "client_secrets_env": "YOUTUBE_CLIENT_SECRETS_PATH",
    "default_privacy": "unlisted",
    "playlist_id": "YOUR_PLAYLIST_ID"
  },
  "defaults": {
    "resolution": "1080p",
    "captions": true,
    "font": "JetBrains Mono",
    "lesson_max_minutes": 10,
    "background_color": "#0d0d1a"
  }
}
